# @carbon/styles and the @ibm/plex packages it pulls in are pure asset packages
# — Sass sources and font files, no build step. The only lifecycle scripts in
# the tree are IBM's telemetry postinstalls, so installs skip scripts entirely:
# the deploy stays deterministic and makes no outbound call beyond the registry.
ignore-scripts=true

# The site is built by Jekyll; npm is only here to vendor the design system.
fund=false
audit=false
